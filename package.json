{
  "name": "izignamx-express-landing",
  "version": "1.0.0",
  "description": "Static PWA Landing Page for IzignaMx Express",
  "scripts": {
    "start": "npx serve .",
    "test": "playwright test",
    "lint": "npx html-validate index.html && npx prettier \"**/*.html\" \"**/*.md\" --check",
    "format": "npx prettier --write \"**/*.{html,md,css,js}\"",
    "pa11y": "npx pa11y http://localhost:3000",
    "build:hero3d": "esbuild src/hero3d-renderer.js src/hero3d-worker.js src/hero3d-scene.js --bundle --format=esm --target=es2020 --minify --legal-comments=linked --outdir=assets/js"
  },
  "keywords": [
    "pwa",
    "landing",
    "leads",
    "static"
  ],
  "author": "IzignaMx",
  "license": "MIT",
  "dependencies": {
    "serve": "^14.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "0.27.3",
    "html-validate": "^10.8.0",
    "pa11y": "^9.1.0",
    "prettier": "^3.8.1",
    "three": "0.183.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
